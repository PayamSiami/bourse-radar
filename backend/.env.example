# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ─── Database (PostgreSQL 16+) ─────────────────────────────
DATABASE_URL=postgres://bourse:bourse123@localhost:5432/bourse_radar

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenAI (LLM narrative generation) ────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-2024-08-06
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# ─── TSETMC / Codal (no auth required, unofficial) ─────────
TSETMC_BASE_URL=https://cdn.tsetmc.com
CODAL_BASE_URL=https://www.codal.ir
USER_AGENT=BourseRadar/0.1 (+https://bourse-radar.ir)

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_WINDOW=60000
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_AUTHENTICATED_WINDOW=60000

# ─── Data Freshness Thresholds ───────────────────────────
PRICE_MAX_AGE_SECONDS=300        # 5 min stale
MONTHLY_SALES_MAX_AGE_DAYS=45
QUARTERLY_MAX_AGE_DAYS=120
FORWARD_PE_CACHE_TTL_SECONDS=900 # 15 min
